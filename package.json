{
	"name": "typescript-template",
	"version": "2.0.0",
	"private": true,
	"description": "TypeScript template for Node.js with ESM, Vitest, XO, and Prettier.",
	"license": "MIT",
	"repository": "github:sebastian-suarez/TypeScript-template",
	"homepage": "https://github.com/sebastian-suarez/TypeScript-template#readme",
	"bugs": "https://github.com/sebastian-suarez/TypeScript-template/issues",
	"author": "Sebastian Suarez <261091557+sebastian-suarez@users.noreply.github.com> (https://www.sebastiansuarez.dev)",
	"type": "module",
	"imports": {
		"#src/*": "./src/*"
	},
	"engines": {
		"node": "^24.15.0 || >=26.0.0"
	},
	"scripts": {
		"start": "tsx ./src/index.js",
		"test": "vitest",
		"lint": "xo --fix",
		"format": "prettier --write .",
		"prepare": "husky"
	},
	"keywords": [
		"typescript",
		"template",
		"node.js",
		"esm",
		"vitest",
		"xo",
		"prettier"
	],
	"devDependencies": {
		"@tsconfig/node24": "^24.0.5",
		"@types/node": "^24.19.2",
		"@typescript/native": "npm:typescript@^7.0.2",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "3.9.10",
		"tsx": "^4.23.15",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"vitest": "^5.0.5",
		"xo": "^5.0.1"
	}
}
