{
	"extends": "@tsconfig/node24/tsconfig.json",
	"compilerOptions": {
		"lib": [
			"es2024",
			"ESNext.Array",
			"ES2025.Collection",
			"ESNext.Error",
			"ESNext.Iterator",
			"ESNext.Promise",
			"DOM",
			"DOM.Iterable"
		],
		"jsx": "react-jsx",
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"types": ["node", "vite/client"],
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true,
		"paths": { "#ui": ["./design-system/source/index.d.ts"] }
	},
	"include": ["src", "tests", "scripts", ".storybook/**/*", "stories", "*.ts"],
	"exclude": [
		"node_modules",
		"dist",
		".cache",
		"tests/consumer",
		"tests/api/generated",
		"tests/api/fixtures"
	]
}
